# Vercel AI Gateway — required. Get from https://vercel.com/dashboard/ai-gateway
AI_GATEWAY_API_KEY=

# Upstash Vector — provisioned via Vercel Marketplace (Integrations → Add). Auto-populates both.
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# Microsoft Graph — Azure AD app registration in Aberdeen's tenant with Sites.Selected (or Files.Read.All) app permission.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=

# SharePoint site + folder holding the Pursuit Armory.
# SITE_ID format: {host},{siteCollectionId},{siteId}  — get via GET /sites/{hostname}:/sites/{siteName}
# FOLDER_PATH is relative to the drive root, e.g. "Pursuit Armory" or "Sales/RFP Assets"
SHAREPOINT_SITE_ID=
SHAREPOINT_ARMORY_FOLDER_PATH=Pursuit Armory
